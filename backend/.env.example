# SAHBI backend — copy to .env and fill in. Never commit .env.
# Every service is optional: anything left empty reports "not configured"
# in GET /v1/health and the app shows an honest "service not configured" state.

# ---- Server
PORT=8080
HOST=0.0.0.0
# Signs anonymous install tokens (HMAC). Set it in production: a long random string,
# e.g. `openssl rand -hex 32`. If empty, an ephemeral secret is generated at startup
# (a warning is logged) and every app must re-authenticate after a restart.
AUTH_SECRET=
# Comma-separated browser origins allowed by CORS (the Android app does not need CORS).
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=30
JSON_BODY_LIMIT_BYTES=65536
AUDIO_BODY_LIMIT_BYTES=2097152

# ---- LLM (anthropic | openai | none)
LLM_PROVIDER=none
# Pick a current model id from your provider's official model list; none is hard-coded.
LLM_MODEL=
LLM_API_KEY=
# Optional: OpenAI-compatible endpoint or proxy. Defaults to the provider's official API.
# Free option: Google Gemini (key from https://aistudio.google.com/apikey):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.8-flash
#   LLM_REASONING_EFFORT=low
#   (Free tier: Google may use the content to improve its products.)
LLM_BASE_URL=
# Optional reasoning_effort for OpenAI-compatible models (e.g. low). Empty = provider default.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=800
CONTEXT_TOKEN_BUDGET=3000

# ---- Web search (brave | none) — https://api-dashboard.search.brave.com
SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=

# ---- Weather: Open-Meteo (no key needed).

# ---- Speech-to-text (azure | openai | none)
STT_PROVIDER=none
# Azure Speech (also used by TTS). ar-MA recognition + ar-MA-JamalNeural / ar-MA-MounaNeural voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# OpenAI transcription (only if STT_PROVIDER=openai). Choose a current transcription model id.
OPENAI_STT_API_KEY=
OPENAI_STT_MODEL=

# ---- Text-to-speech (azure | none)
TTS_PROVIDER=none
AZURE_TTS_VOICE=ar-MA-JamalNeural
